# Fresh Local AI Content Studio Environment Configuration
# Copy this file to .env for local runtime configuration.

# Application Core
APP_ENV=development
LOG_LEVEL=INFO

# API Server (FastAPI)
API_HOST=127.0.0.1
API_PORT=8400
DATABASE_URL=sqlite+aiosqlite:///data/db/studio.sqlite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8400

# Worker Process
WORKER_POLL_INTERVAL_SECONDS=2

# Storage & Retention
STORAGE_BASE_DIR=data

# Cost Controls
MAX_AI_COST_PER_DAY=5.00
MAX_GENERATION_COST_PER_PROJECT=2.00
MAX_VIDEO_SECONDS_PER_PROJECT=180

# AI Provider Keys (Kept empty by default; mock mode enabled)
AI_MOCK_MODE=true
GEMINI_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
# OPENAI_COTENT_STUDIO is also accepted for existing Windows user environments.
# OPENAI_CONTENT_STUDIO is accepted as the correctly spelled compatibility alias.
OPENAI_MODEL=gpt-6-luna
# GPT-6 Luna supports none, low, medium, high, xhigh, and max reasoning effort.
OPENAI_REASONING_EFFORT=medium
# Set these optional per-million token rates when OPENAI_MODEL is changed.
# OPENAI_PROMPT_COST_PER_MILLION=
# OPENAI_CACHED_PROMPT_COST_PER_MILLION=
# OPENAI_CACHE_WRITE_PROMPT_COST_PER_MILLION=
# OPENAI_COMPLETION_COST_PER_MILLION=
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=qwen

# Media & TTS. Production uses installed Windows SAPI5 voices; tests opt into mock mode explicitly.
TTS_MOCK_MODE=false
FFMPEG_BINARY=ffmpeg

# Platform Default Launchers (Manual publishing V1)
PLATFORM_YOUTUBE_STUDIO_URL=https://studio.youtube.com/
PLATFORM_FACEBOOK_URL=https://www.facebook.com/
PLATFORM_INSTAGRAM_URL=https://www.instagram.com/
PLATFORM_TIKTOK_URL=https://www.tiktok.com/upload
